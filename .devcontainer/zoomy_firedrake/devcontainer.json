{
  "name": "Zoomy + Firedrake + AMR",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "../.."
  },
  "remoteUser": "root",
  
  // 1. Tell VS Code WHERE to map the files
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",
  
  // 2. Tell VS Code where to start the terminal
  "workspaceFolder": "/workspace",

  "settings": {
    "terminal.integrated.defaultProfile.linux": "bash",
    "python.defaultInterpreterPath": "/opt/firedrake/bin/python"
  },
  "remoteEnv": {
    "PYTHONPATH": "/opt/firedrake:/workspace/library/zoomy_core:/workspace/library/firedrake_animate:/workspace/library/zoomy_firedrake",
    "ZOOMY_DIR": "/workspace"
  },
  "updateContentCommand": "for dir in library/zoomy_core library/firedrake_animate library/zoomy_firedrake; do python3 -m pip install -e \"$dir\"; done",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter",
        "tamasfe.even-better-toml",
        "redhat.vscode-yaml",
        "oderwat.indent-rainbow"
      ],
      "settings": {
        "python.formatting.provider": "black",
        "editor.formatOnSave": true
      }
    }
  },
  "forwardPorts": [8888, 8000, 8080]
}