Bootstrap: docker
From: condaforge/miniforge3:24.11.3-0

# JAX + Zoomy for distributed runs: one MPI rank per GPU (or per CPU core
# group), halo exchange by mpi4jax inside the compiled loop.
#   - JAX 0.9.2 with its CUDA 12 wheels (runs on the CPU without a GPU)
#   - OpenMPI 5 + UCX (conda-forge), CUDA-aware: halo buffers go GPU -> GPU
#     (UCX cuda_ipc / cuda_copy), no copy through host memory
#   - mpi4py, mpi4jax 0.9.1.post2 built against that OpenMPI, with CUDA
# Same three modes as the other backend images (server / jupyter / shell).
#
# Build from the Zoomy repo root:
#   apptainer build --fakeroot containers/zoomy_jax_mpi/zoomy_jax_mpi.sif \
#     containers/zoomy_jax_mpi/zoomy_jax_mpi.def
# Run, one node (the container's own mpiexec; each rank binds one GPU):
#   apptainer exec --nv zoomy_jax_mpi.sif mpiexec -n 4 python run.py
# Several nodes (host launcher, PMIx):
#   srun --mpi=pmix apptainer exec --nv zoomy_jax_mpi.sif python run.py
# Staged exchange instead (through host memory): MPI4JAX_USE_CUDA_MPI=0.
#
# NOTE: %files dest is /opt/src, NOT /tmp (Apptainer bind-mounts host /tmp).

%labels
    Author ZoomyLab
    Description JAX + Zoomy, distributed (OpenMPI 5 + UCX, CUDA-aware, mpi4jax)

%files
    library/zoomy_core     /opt/src/zoomy_core
    library/zoomy_jax      /opt/src/zoomy_jax
    library/zoomy_server   /opt/src/zoomy_server
    library/zoomy_prepost  /opt/src/zoomy_prepost
    library/zoomy_plotting /opt/src/zoomy_plotting

%environment
    export PATH=/opt/conda/envs/zoomy/bin:$PATH
    export CONDA_PREFIX=/opt/conda/envs/zoomy
    export PYTHONNOUSERSITE=1
    export ZOOMY_ADAPTER=jax
    export ZOOMY_PORT=8080
    export ZOOMY_ROOT=/workspace
    # CUDA-aware OpenMPI: conda-forge ships it with CUDA buffer support off;
    # UCX carries the GPU buffers; its memtype cache misses JAX's allocator
    # (small messages would be copied as host memory and crash).
    export OMPI_MCA_opal_cuda_support=true
    export OMPI_MCA_pml=ucx
    export UCX_MEMTYPE_CACHE=n
    export MPI4JAX_USE_CUDA_MPI=1
    # mpiexec inside the container, as root under --fakeroot
    export OMPI_ALLOW_RUN_AS_ROOT=1 OMPI_ALLOW_RUN_AS_ROOT_CONFIRM=1

%post
    set -e
    export DEBIAN_FRONTEND=noninteractive
    apt-get update && apt-get install -y --no-install-recommends gcc g++ \
        && rm -rf /var/lib/apt/lists/*
    mamba create -y -n zoomy -c conda-forge python=3.12 "openmpi>=5,<6" ucx \
        cuda-version=12.9 mpi4py numpy=2.3 scipy=1.16 sympy=1.14 param=2.2 \
        "h5py=*=mpi_openmpi*" meshio pyamg loguru matplotlib pip nanobind \
        setuptools wheel cython
    mamba clean -afy
    export PATH=/opt/conda/envs/zoomy/bin:$PATH
    printf 'jax==0.9.2\njaxlib==0.9.2\n' > /opt/jaxpin.txt
    pip install --no-cache-dir "jax[cuda12]==0.9.2" equinox==0.13.6
    # mpi4jax: OpenMPI's wrapper with the system compiler; CUDA headers and
    # cudart from the nvidia wheels that came with jax[cuda12]
    OMPI_CC=gcc OMPI_CXX=g++ PIP_CONSTRAINT=/opt/jaxpin.txt pip install \
        --no-cache-dir --no-build-isolation "mpi4jax==0.9.1.post2"
    PIP_CONSTRAINT=/opt/jaxpin.txt pip install --no-cache-dir \
        jupyterlab jupyter-server ipykernel \
        /opt/src/zoomy_core /opt/src/zoomy_jax /opt/src/zoomy_server \
        /opt/src/zoomy_prepost /opt/src/zoomy_plotting
    rm -rf /opt/src
    mkdir -p /workspace

%runscript
    case "${1:-}" in
        jupyter)    exec zoomy-jupyter --port "${2:-8888}" ;;
        shell|bash) exec /bin/bash ;;
        server)     exec zoomy-server --adapter "${2:-$ZOOMY_ADAPTER}" --port "${3:-$ZOOMY_PORT}" ;;
        "")         exec zoomy-server --adapter "$ZOOMY_ADAPTER" --port "$ZOOMY_PORT" ;;
        *)          exec zoomy-server --adapter "$ZOOMY_ADAPTER" --port "$1" ;;
    esac

%startscript
    exec zoomy-server --adapter "$ZOOMY_ADAPTER" --port "$ZOOMY_PORT"

%test
    python -c "import zoomy_core, zoomy_jax, zoomy_server, mpi4py, mpi4jax, jax; print('imports OK', jax.__version__)"
    python -c "from mpi4jax._src.utils import has_cuda_support as h; assert h(); print('mpi4jax CUDA OK')"
    ompi_info --parsable --all | grep -q 'mpi_built_with_cuda_support:value:true' && echo "OpenMPI CUDA-aware"
