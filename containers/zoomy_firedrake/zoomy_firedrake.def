Bootstrap: docker
From: ghcr.io/zoomylab/zoomy_firedrake_dev:latest

# Triple-purpose Firedrake image (firedrake + PETSc + jupyterlab from the dev base,
# + zoomy_core/firedrake/server/prepost):
#   1. Solver API : apptainer run zoomy_firedrake.sif [port]        (FastAPI :8080)
#   2. Jupyter    : apptainer run zoomy_firedrake.sif jupyter [port]     (Lab :8888)
#   3. Dev/shell  : apptainer run zoomy_firedrake.sif shell
# Firedrake is CPU (PETSc); the adapter converts its .pvd output via zoomy_prepost.
#   apptainer build --fakeroot containers/zoomy_firedrake/zoomy_firedrake.sif containers/zoomy_firedrake/zoomy_firedrake.def
#
# NOTE: %files dest is /opt/src, NOT /tmp (Apptainer bind-mounts host /tmp in %post).

%labels
    Author ZoomyLab
    Description Firedrake + Zoomy — API :8080 + Jupyter :8888 + dev shell

%files
    library/zoomy_core        /opt/src/zoomy_core
    library/firedrake_animate /opt/src/firedrake_animate
    library/zoomy_firedrake   /opt/src/zoomy_firedrake
    library/zoomy_server      /opt/src/zoomy_server
    library/zoomy_prepost     /opt/src/zoomy_prepost

%environment
    export ZOOMY_ADAPTER=firedrake
    export ZOOMY_PORT=8080
    export ZOOMY_ROOT=/workspace

%post
    set -e
    # Do NOT `pip install --upgrade pip` — the Firedrake base uses Debian's
    # python3-pip (no RECORD), which upgrading breaks. jupyterlab is already in
    # the dev base; add jupyter-server + ipykernel + our libs.
    python3 -m pip install --no-cache-dir \
        meshio jupyter-server ipykernel \
        /opt/src/zoomy_core /opt/src/firedrake_animate /opt/src/zoomy_firedrake \
        /opt/src/zoomy_server /opt/src/zoomy_prepost
    rm -rf /opt/src
    mkdir -p /workspace

%runscript
    # Triple-purpose dispatch ($ZOOMY_ADAPTER=firedrake baked):
    case "${1:-}" in
        jupyter)    exec zoomy-jupyter --port "${2:-8888}" ;;
        shell|bash) exec /bin/bash ;;
        server)     exec zoomy-server --adapter "${2:-$ZOOMY_ADAPTER}" --port "${3:-$ZOOMY_PORT}" ;;
        "")         exec zoomy-server --adapter "$ZOOMY_ADAPTER" --port "$ZOOMY_PORT" ;;
        *)          exec zoomy-server --adapter "$ZOOMY_ADAPTER" --port "$1" ;;
    esac

%startscript
    exec zoomy-server --adapter "$ZOOMY_ADAPTER" --port "$ZOOMY_PORT"

%test
    python3 -c "import zoomy_core, zoomy_firedrake, zoomy_server, zoomy_prepost, meshio; print('imports OK')"
    python3 -c "import firedrake; print('firedrake OK')"
    zoomy-server  --help >/dev/null 2>&1 && echo "zoomy-server CLI OK"
    zoomy-jupyter --help >/dev/null 2>&1 && echo "zoomy-jupyter CLI OK"
