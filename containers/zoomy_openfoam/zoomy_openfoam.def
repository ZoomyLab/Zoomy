Bootstrap: docker
From: ubuntu:24.04

%labels
    Author ZoomyLab
    Description OpenFOAM 13 (Foundation/openfoam.org) + preCICE 3.x for the zoomyFoam backend
    OpenFOAM_Version 13
    preCICE_Version 3.4.1
    pyprecice_Version 3.4.0

%help
    OpenFOAM 13 (openfoam.org Foundation line) + the preCICE coupling library.
    This is the OpenFOAM counterpart of the zoomy_amrex / zoomy_dmplex backends:
    it provides the toolchain to compile and run the custom `zoomyFoam` solver
    (library/zoomy_foam) with `wmake`, plus preCICE for coupling.

    NOTE on the preCICE OpenFOAM adapter: the generic precice/openfoam-adapter is
    intentionally NOT built here. It has no OpenFOAM 11/12/13 (Foundation) branch —
    its maintained track is the ESI/openfoam.com line — and zoomyFoam is a Foundation
    solver that drives preCICE from its own solver code via libprecice/pyprecice.
    The mirror reference container (openfoam_fenicsx_precice) likewise shipped the
    libraries only, without the adapter.

    This image is ALSO a normal Zoomy backend (like zoomy_numpy): it bakes the
    python solver stack (zoomy_core/server/prepost/plotting/foam) and serves the
    FastAPI job API with ZOOMY_ADAPTER=foam, so a coupled SME<->VOF case runs
    end-to-end INSIDE one container — it emits the model, wmakes zoomyFoam on
    demand, and runs both preCICE participants locally (no pre-baked binaries).

    Build (from the repo root, so the %files sources resolve):
        apptainer build --fakeroot \
            containers/zoomy_openfoam/zoomy_openfoam.sif \
            containers/zoomy_openfoam/zoomy_openfoam.def
    Serve:   apptainer run zoomy_openfoam.sif 8194     # foam API on :8194
    Compile zoomyFoam by hand (repo bind-mounted at /workspace):
        apptainer exec --bind <repo>:/workspace zoomy_openfoam.sif \
            bash -c 'source /opt/openfoam13/etc/bashrc && cd /workspace/library/zoomy_foam && wclean && wmake'

%files
    # Same pip-from-tree layout as containers/zoomy_numpy.def; zoomy_foam's
    # create_model.py needs sympy + zoomy_core at runtime to emit the C++ model.
    library/zoomy_core     /opt/src/zoomy_core
    library/zoomy_server   /opt/src/zoomy_server
    library/zoomy_prepost  /opt/src/zoomy_prepost
    library/zoomy_plotting /opt/src/zoomy_plotting
    library/zoomy_foam     /opt/src/zoomy_foam
    # Triple-purpose dispatch, baked at a fixed path so the pipeline's
    # docker-twin (built by `docker import --change ENTRYPOINT=...`) reuses the
    # exact same script as the .sif %runscript below.
    containers/zoomy_openfoam/zoomy-entry /usr/local/bin/zoomy-entry

%environment
    export LC_ALL=C
    # Normal-backend wiring (mirrors zoomy_numpy): default adapter + API port.
    export ZOOMY_ADAPTER=foam
    export ZOOMY_PORT=8080
    export ZOOMY_ROOT=/workspace
    # OpenFOAM 13 environment (Foundation). Sourced for every `apptainer exec/run`
    # so foamRun/wmake are on PATH — the foam adapter and the case scripts detect
    # "in-container" via `command -v foamRun` and then run wmake / the coupled
    # solvers directly (no nested apptainer).
    if [ -f /opt/openfoam13/etc/bashrc ]; then
        . /opt/openfoam13/etc/bashrc || true
    fi

%post
    set -eu
    export DEBIAN_FRONTEND=noninteractive

    echo "##### STEP 1/6: base tooling + preCICE/OpenFOAM build dependencies"
    apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        gnupg \
        wget \
        curl \
        git \
        software-properties-common \
        apt-transport-https \
        build-essential \
        cmake \
        flex \
        bison \
        pkg-config \
        python3 \
        python3-dev \
        python3-pip \
        python3-numpy \
        cython3 \
        python3-mpi4py \
        libeigen3-dev \
        libxml2-dev \
        libboost-all-dev

    echo "##### STEP 2/6: OpenFOAM 13 apt repo (Foundation / openfoam.org), noble"
    # The deb mirror is served over HTTP; trust comes from the HTTPS-fetched gpg key.
    wget -qO - https://dl.openfoam.org/gpg.key > /etc/apt/trusted.gpg.d/openfoam.asc
    echo 'deb http://dl.openfoam.org/ubuntu noble main' > /etc/apt/sources.list.d/openfoam.list
    apt-get update

    echo "##### STEP 3/6: install openfoam13 (--no-install-recommends skips ParaView)"
    apt-get install -y --no-install-recommends openfoam13
    test -f /opt/openfoam13/etc/bashrc

    echo "##### STEP 4/6: preCICE 3.4.1 library (prebuilt deb)"
    # `apt install ./file.deb` (not dpkg -i) so apt resolves the hard deps
    # (libboost, libxml2, petsc-dev, mpi-default-dev). Stage in /root, NOT /tmp
    # (apptainer build can expose the host /tmp).
    PRECICE_VER=3.4.1
    wget -q "https://github.com/precice/precice/releases/download/v${PRECICE_VER}/libprecice3_${PRECICE_VER}_noble.deb" \
        -O /root/libprecice3.deb
    apt-get install -y /root/libprecice3.deb
    rm -f /root/libprecice3.deb
    pkg-config --modversion libprecice

    echo "##### STEP 5/6: pyprecice (Python bindings; source build against libprecice)"
    # 3.4.1 is not on PyPI; bindings track maj.min. PEP 668 -> --break-system-packages.
    # Cython/mpi4py/numpy provided via apt so the build is deterministic.
    pip3 install --no-cache-dir --break-system-packages pyprecice==3.4.0
    python3 -c "import precice"

    echo "##### STEP 6/7: python solver stack (zoomy_core/server/prepost/plotting/foam)"
    # PEP 668 -> --break-system-packages (same as pyprecice above). Pin numpy<2 so
    # pip KEEPS the apt-provided 1.26.4: Debian ships numpy without a RECORD file,
    # so pip cannot uninstall it, and an unpinned resolve picks numpy 2.x and aborts
    # ("Cannot uninstall numpy 1.26.4"). 1.26.4 is the last 1.x, so "<2" resolves to
    # the installed version -> no uninstall, and pyprecice's source-build ABI stays
    # intact. h5py/meshio/matplotlib are the IO+plot deps prepost/plotting use.
    # pytest + the report plugins are REQUIRED, not optional: CI's foam job runs
    # tests/reporting/generate_test_report.py inside this image, exactly like the
    # core/jax/amrex images do. Without them the job dies at
    # "/usr/bin/python3: No module named pytest" before collecting anything —
    # which is what happened the first time the foam stack was given a CI job
    # (2026-07-22). Every other test image ships these; this one did not.
    pip3 install --no-cache-dir --break-system-packages \
        "numpy<2" \
        h5py meshio matplotlib jupyterlab jupyter-server ipykernel \
        pytest pytest-html pytest-metadata \
        /opt/src/zoomy_core /opt/src/zoomy_prepost /opt/src/zoomy_plotting \
        /opt/src/zoomy_server /opt/src/zoomy_foam
    python3 -c "import zoomy_core, zoomy_server, zoomy_prepost, zoomy_plotting, zoomy_foam, precice; print('zoomy python layer OK')"
    python3 -c "import pytest, pytest_html; print('pytest', pytest.__version__, 'OK')"
    zoomy-server --help >/dev/null && echo "zoomy-server CLI OK"
    rm -rf /opt/src
    mkdir -p /workspace     # dev-container / bind target ($ZOOMY_ROOT)

    echo "##### STEP 7/7: env wiring + slim down"
    chmod +x /usr/local/bin/zoomy-entry
    grep -q 'openfoam13/etc/bashrc' /root/.bashrc 2>/dev/null || \
        echo '. /opt/openfoam13/etc/bashrc' >> /root/.bashrc
    apt-get clean
    rm -rf /var/lib/apt/lists/* /root/.cache
    echo "##### POST COMPLETE"

%runscript
    # Delegate to the baked /usr/local/bin/zoomy-entry (sources the OpenFOAM env,
    # then the triple-purpose dispatch). The pipeline's Docker twin uses the same
    # file as its ENTRYPOINT, so `run img [port|jupyter|shell|<cmd>]` is identical
    # between the .sif and the Docker image.
    exec /usr/local/bin/zoomy-entry "$@"

%startscript
    exec zoomy-server --adapter "$ZOOMY_ADAPTER" --port "${ZOOMY_PORT:-8080}"

%test
    #!/bin/bash
    set -e
    echo "=== Zoomy OpenFOAM Container Verification ==="

    echo "1. Python version (need >= 3.11)..."
    python3 --version
    python3 -c "import sys; assert sys.version_info >= (3, 11), sys.version"

    echo "2. OpenFOAM 13 environment..."
    # OpenFOAM's bashrc returns non-zero under `set -e` (a harmless pop_var_context
    # warning as errexit leaks into the sourced file); source it with errexit
    # disabled — the environment still applies (WM_PROJECT_VERSION, PATH, ...).
    set +e; . /opt/openfoam13/etc/bashrc; set -e
    echo "   WM_PROJECT_VERSION=$WM_PROJECT_VERSION"
    test "$WM_PROJECT_VERSION" = "13" || { echo "FAIL: expected OpenFOAM 13"; exit 1; }
    command -v foamRun  >/dev/null && echo "   foamRun:  OK"  || { echo "FAIL: foamRun missing"; exit 1; }
    command -v blockMesh >/dev/null && echo "   blockMesh: OK" || { echo "FAIL: blockMesh missing"; exit 1; }
    command -v wmake    >/dev/null && echo "   wmake:    OK"  || { echo "FAIL: wmake missing"; exit 1; }

    echo "3. preCICE library..."
    pkg-config --modversion libprecice && echo "   libprecice pkg-config: OK" || { echo "FAIL: libprecice not found"; exit 1; }

    echo "4. pyprecice import..."
    python3 -c "import precice; print('   pyprecice', precice.get_version_information() if hasattr(precice,'get_version_information') else 'imported')"

    echo "5. Zoomy python backend stack..."
    python3 -c "import zoomy_core, zoomy_server, zoomy_prepost, zoomy_plotting, zoomy_foam; print('   zoomy imports OK')"
    zoomy-server --help >/dev/null 2>&1 && echo "   zoomy-server CLI OK" || { echo "FAIL: zoomy-server CLI"; exit 1; }

    echo "=== All checks passed ==="
