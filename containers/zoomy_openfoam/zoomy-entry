#!/bin/bash
# OpenFOAM backend entry — installed at /usr/local/bin/zoomy-entry and used by
# BOTH the .sif (%runscript exec's it) AND the pipeline-built Docker twin (set as
# ENTRYPOINT via `docker import --change`), so the two artifacts dispatch
# identically. This is the OpenFOAM sibling of containers/common/zoomy-entry: it
# additionally sources the OpenFOAM 13 environment first, because the foam adapter
# and the coupled-case scripts detect "in-container" via `command -v foamRun`.
#   run img                       -> foam API on $ZOOMY_PORT
#   run img <port>                -> foam API on <port>              (back-compat)
#   run img server [adapter] [port]
#   run img jupyter [port]        -> Jupyter Lab (default 8888)
#   run img shell|bash            -> interactive bash (dev container)
#   run img <cmd> [args...]       -> exec the command (e.g. wmake)
if [ -f /opt/openfoam13/etc/bashrc ]; then . /opt/openfoam13/etc/bashrc || true; fi
case "${1:-}" in
    jupyter)    exec zoomy-jupyter --port "${2:-8888}" ;;
    shell)      exec /bin/bash ;;
    bash)       if [ $# -eq 1 ]; then exec /bin/bash; else exec "$@"; fi ;;
    server)     exec zoomy-server --adapter "${2:-$ZOOMY_ADAPTER}" --port "${3:-${ZOOMY_PORT:-8080}}" ;;
    "")         exec zoomy-server --adapter "$ZOOMY_ADAPTER" --port "${ZOOMY_PORT:-8080}" ;;
    *[!0-9]*)   exec "$@" ;;
    *)          exec zoomy-server --adapter "$ZOOMY_ADAPTER" --port "$1" ;;
esac
