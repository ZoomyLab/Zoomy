Bootstrap: docker
From: ubuntu:22.04

%labels
    Author ZoomyLab
    Description AMReX development container with host-MPI bind support

%environment
    export AMREX_HOME=/opt/amrex
    export ZOOMY_AMREX_HOME=/opt/amrex
    export LC_ALL=C
    export PATH="/usr/local/bin:$PATH"

%post
    export DEBIAN_FRONTEND=noninteractive

    apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        gfortran \
        git \
        ca-certificates \
        python3 \
        python3-pip \
        python3-dev \
        python3-venv \
        pkg-config \
        libopenmpi-dev \
        openmpi-bin \
        libhdf5-openmpi-dev \
        wget \
    && rm -rf /var/lib/apt/lists/*

    python3 -m pip install --no-cache-dir --upgrade pip
    python3 -m pip install --no-cache-dir \
        numpy scipy sympy attrs meshio pytest rasterio h5py

    # --- Build AMReX from source ---
    git clone --depth 1 --branch 25.02 \
        https://github.com/AMReX-Codes/amrex.git /opt/amrex

    # Compile AMReX base library to verify the toolchain works
    cd /opt/amrex && make -C Src/Base -j$(nproc) \
        AMREX_HOME=/opt/amrex USE_MPI=TRUE COMP=gnu DIM=3 DEBUG=FALSE \
        || echo "AMReX base compile check done"

    # Clean build artifacts to reduce image size, keep source + headers
    find /opt/amrex -name "*.o" -delete 2>/dev/null || true

%runscript
    echo "zoomy_amrex container (AMReX at /opt/amrex)"
    exec /bin/bash "$@"

%test
    echo "=== AMReX Container Verification ==="
    echo "1. Checking compilers..."
    gcc --version | head -1
    gfortran --version | head -1
    mpicxx --version | head -1

    echo "2. Checking AMReX installation..."
    test -d /opt/amrex/Src/Base && echo "AMReX source: OK" || exit 1
    test -f /opt/amrex/Tools/GNUMake/Make.defs && echo "AMReX Make.defs: OK" || exit 1

    echo "3. Checking Python..."
    python3 -c "import numpy; import sympy; import attrs; print('Python deps: OK')"

    echo "4. Checking MPI..."
    mpicc --version | head -1

    echo "=== All checks passed ==="
