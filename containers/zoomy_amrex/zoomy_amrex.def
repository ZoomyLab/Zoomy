Bootstrap: docker
From: ubuntu:24.04

# AMReX + Zoomy solver server. Mirrors ./Dockerfile — bakes zoomy-server so the
# image serves the amrex backend natively over the FastAPI (the GUI connects to
# it on :8080). Build from the Zoomy repo root (so the %files sources resolve):
#   apptainer build --fakeroot \
#     containers/zoomy_amrex/zoomy_amrex.sif containers/zoomy_amrex/zoomy_amrex.def
#   apptainer run containers/zoomy_amrex/zoomy_amrex.sif [port]   # default 8080
#
# One image for CPU and GPU machines: it carries the CUDA 12.6 compiler and the
# libraries a GPU build links, and the generated solver is compiled for the CPU or
# with CUDA as the run asks (zoomy_amrex.symsolver `gpu=`; run_case:
# ZOOMY_AMREX_CUDA=1).  A GPU run needs the host's NVIDIA driver in the container:
#   apptainer exec --nv containers/zoomy_amrex/zoomy_amrex.sif <cmd>
# Multi-GPU: one rank per GPU through this OpenMPI (not CUDA-aware: AMReX stages
# the halos through the host).
#
# NOTE: %files dest is /opt/src, NOT /tmp — Apptainer bind-mounts the host /tmp
# during %post, which would mask anything copied under /tmp.

%labels
    Author ZoomyLab
    Description AMReX + Zoomy solver server (--adapter amrex) on :8080

%files
    library/zoomy_core    /opt/src/zoomy_core
    library/zoomy_amrex   /opt/src/zoomy_amrex
    library/zoomy_server  /opt/src/zoomy_server
    library/zoomy_prepost /opt/src/zoomy_prepost
    library/zoomy_plotting /opt/src/zoomy_plotting

%environment
    export AMREX_HOME=/opt/amrex
    export ZOOMY_AMREX_HOME=/opt/amrex
    # zoomy_amrex.symsolver: build and run natively (no nested apptainer)
    export ZOOMY_AMREX_IN_IMAGE=1
    export ZOOMY_ROOT=/workspace
    export ZOOMY_ADAPTER=amrex
    export ZOOMY_PORT=8080
    export LC_ALL=C
    export CUDA_HOME=/usr/local/cuda
    export PATH="/usr/local/bin:/usr/local/cuda/bin:$PATH"
    export NVIDIA_DRIVER_CAPABILITIES=compute,utility

%post
    set -e
    export DEBIAN_FRONTEND=noninteractive
    apt-get update && apt-get install -y --no-install-recommends \
        build-essential gfortran git ca-certificates \
        python3 python3-pip python3-dev python3-venv pkg-config \
        libopenmpi-dev openmpi-bin libhdf5-openmpi-dev wget \
    && rm -rf /var/lib/apt/lists/*

    # CUDA 12.6 (NVIDIA's apt repository): nvcc and the libraries the CUDA build links
    # (cudart, curand, cusparse: AMReX; cublas, cusolver: hypre-CUDA; nvtx: TINY_PROFILE;
    # the driver stub libcuda.so for the link, the real one comes with --nv), shared
    # libraries only: the static archives (1.5 GB) are deleted, but cudart's (nvcc links
    # it).  Nothing runs on a GPU unless a run asks for the CUDA build, so a CPU-only
    # machine never needs a driver.
    wget -q https://developer.download.nvidia.com/compute/cuda/repos/ubuntu2404/x86_64/cuda-keyring_1.1-1_all.deb \
        -O /root/cuda-keyring.deb
    dpkg -i /root/cuda-keyring.deb && rm -f /root/cuda-keyring.deb
    apt-get update && apt-get install -y --no-install-recommends \
        cuda-nvcc-12-6 cuda-cudart-dev-12-6 cuda-driver-dev-12-6 cuda-cccl-12-6 \
        cuda-nvtx-12-6 cuda-profiler-api-12-6 libcurand-dev-12-6 libcusparse-dev-12-6 \
        libcublas-dev-12-6 libcusolver-dev-12-6 \
    && rm -rf /var/lib/apt/lists/*
    find /usr/local/cuda-12.6 -name 'lib*_static*.a' ! -name libcudart_static.a -delete
    ln -sfn /usr/local/cuda-12.6 /usr/local/cuda
    /usr/local/cuda/bin/nvcc --version | tail -1

    # h5py/meshio = HDF5 mesh/result IO; fastapi/uvicorn = the server.
    python3 -m pip install --no-cache-dir --break-system-packages \
        numpy scipy sympy attrs meshio pytest rasterio h5py \
        "fastapi>=0.100" "uvicorn[standard]>=0.20" \
        jupyterlab jupyter-server ipykernel

    # preCICE 3.4.0 for the coupled AMReX participant (zoomy_amrex symsolver
    # couple=...).  3.4.0 = the Python peers' version (conda-forge pyprecice
    # 3.4.0): preCICE refuses to couple different versions.  `apt install
    # ./deb` resolves its hard deps (boost, libxml2, petsc, mpi-default-dev);
    # staged in /root (apptainer build may expose the host /tmp).  After
    # the pip stack: its deps pull Debian's numpy, which pip cannot uninstall.
    PRECICE_VER=3.4.0
    wget -q "https://github.com/precice/precice/releases/download/v${PRECICE_VER}/libprecice3_${PRECICE_VER}_noble.deb" \
        -O /root/libprecice3.deb
    apt-get update && apt-get install -y --no-install-recommends /root/libprecice3.deb \
    && rm -f /root/libprecice3.deb && rm -rf /var/lib/apt/lists/*
    pkg-config --modversion libprecice

    # AMReX from source (headers + source kept, object files pruned). zoomy_amrex
    # code-gens + compiles per model at RUNTIME, so no compile at install time.
    git clone --depth 1 --branch 25.02 \
        https://github.com/AMReX-Codes/amrex.git /opt/amrex
    find /opt/amrex -name "*.o" -delete 2>/dev/null || true
    mkdir -p /workspace

    # Zoomy core + amrex backend + the FastAPI server (LAST, so a failure here
    # aborts the build under `set -e`).
    export AMREX_HOME=/opt/amrex ZOOMY_AMREX_HOME=/opt/amrex
    # zoomy_amrex EDITABLE: run_case resolves the C++ templates as
    # <pkg>/../Source (repo layout) — a plain install ships only the python
    # package. Keep /opt/src/zoomy_amrex; prune the rest.
    python3 -m pip install --no-cache-dir --break-system-packages \
        /opt/src/zoomy_core /opt/src/zoomy_server /opt/src/zoomy_prepost /opt/src/zoomy_plotting \
        -e /opt/src/zoomy_amrex
    rm -rf /opt/src/zoomy_core /opt/src/zoomy_server /opt/src/zoomy_prepost /opt/src/zoomy_plotting

%runscript
    # Triple-purpose dispatch ($ZOOMY_ADAPTER=amrex baked):
    #   run img | run img <port> | run img server [adapter] [port]
    #   run img jupyter [port] | run img shell
    case "${1:-}" in
        jupyter)    exec zoomy-jupyter --port "${2:-8888}" ;;
        shell|bash) exec /bin/bash ;;
        server)     exec zoomy-server --adapter "${2:-$ZOOMY_ADAPTER}" --port "${3:-$ZOOMY_PORT}" ;;
        "")         exec zoomy-server --adapter "$ZOOMY_ADAPTER" --port "$ZOOMY_PORT" ;;
        *)          exec zoomy-server --adapter "$ZOOMY_ADAPTER" --port "$1" ;;
    esac

%startscript
    exec zoomy-server --adapter "$ZOOMY_ADAPTER" --port "$ZOOMY_PORT"

%test
    python3 -c "import zoomy_core, zoomy_amrex, zoomy_server, zoomy_prepost, zoomy_plotting, h5py, meshio; print('imports OK')"
    test -d /opt/amrex/Src/Base && echo "AMReX source OK"
    pkg-config --modversion libprecice
    zoomy-server  --help >/dev/null 2>&1 && echo "zoomy-server CLI OK"
    zoomy-jupyter --help >/dev/null 2>&1 && echo "zoomy-jupyter CLI OK"
    nvcc --version | tail -1
