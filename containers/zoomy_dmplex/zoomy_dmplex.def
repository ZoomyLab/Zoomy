Bootstrap: docker
From: ubuntu:24.04

# PETSc/DMPlex + Zoomy solver server. Mirrors ./Dockerfile — bakes zoomy-server so
# the image serves the dmplex backend natively over the FastAPI (GUI connects on
# :8080). Build from the Zoomy repo root (so %files resolve). NOTE: PETSc is built
# from source with many --download packages, so this is a LONG build (~30-60 min).
#   apptainer build --fakeroot containers/zoomy_dmplex/zoomy_dmplex.sif containers/zoomy_dmplex/zoomy_dmplex.def
#   apptainer run containers/zoomy_dmplex/zoomy_dmplex.sif [port]
#
# %files dest is /opt/src, NOT /tmp (Apptainer bind-mounts host /tmp during %post).

%labels
    Author ZoomyLab
    Description PETSc/DMPlex + Zoomy solver server (--adapter dmplex) on :8080

%files
    library/zoomy_core    /opt/src/zoomy_core
    library/zoomy_server  /opt/src/zoomy_server
    library/zoomy_prepost /opt/src/zoomy_prepost
    # The dmplex adapter compiles the C++ solver source at run time (make CPU),
    # so ship it at ZOOMY_ROOT=/workspace where _find_solver_source looks.
    library/zoomy_dmplex /workspace/library/zoomy_dmplex

%environment
    export PETSC_DIR=/opt/petsc
    export PETSC_ARCH=arch-container-opt
    export LC_ALL=C
    export PATH="/usr/local/bin:$PATH"
    export LD_LIBRARY_PATH="/opt/petsc/arch-container-opt/lib:$LD_LIBRARY_PATH"
    export PYTHONPATH="/opt/petsc/arch-container-opt/lib:$PYTHONPATH"
    export ZOOMY_ROOT=/workspace
    export ZOOMY_ADAPTER=dmplex
    export ZOOMY_PORT=8080

%post
    set -e
    export DEBIAN_FRONTEND=noninteractive
    apt-get update && apt-get install -y --no-install-recommends \
        build-essential gfortran git ca-certificates \
        python3 python3-pip python3-dev python3-venv pkg-config cmake \
        libopenmpi-dev openmpi-bin wget flex bison valgrind \
    && rm -rf /var/lib/apt/lists/*

    python3 -m pip install --no-cache-dir --break-system-packages \
        numpy scipy "sympy>=1.14" param loguru attrs "cython<3.1" pytest h5py meshio \
        "fastapi>=0.100" "uvicorn[standard]>=0.20" \
        jupyterlab jupyter-server ipykernel

    # --- PETSc from source ---
    export PETSC_DIR=/opt/petsc PETSC_ARCH=arch-container-opt
    git clone --depth 1 --branch v3.23.3 https://gitlab.com/petsc/petsc.git "$PETSC_DIR"
    cd "$PETSC_DIR"
    python3 ./configure \
        --with-cc=mpicc --with-cxx=mpicxx --with-fc=mpif90 \
        COPTFLAGS="-O2" CXXOPTFLAGS="-O2" FOPTFLAGS="-O2" \
        --with-debugging=0 --with-shared-libraries=1 --with-fortran-bindings=0 \
        --download-hdf5 --download-metis --download-parmetis --download-eigen \
        --download-ptscotch --download-netlib-lapack --download-fblaslapack \
        --download-scalapack --download-mumps --download-superlu_dist \
        --download-triangle --with-petsc4py=1
    make PETSC_DIR=$PETSC_DIR PETSC_ARCH=$PETSC_ARCH all -j$(nproc)
    find "$PETSC_DIR/$PETSC_ARCH" -name "*.o" -delete 2>/dev/null || true
    rm -rf "$PETSC_DIR/.git" "$PETSC_DIR/$PETSC_ARCH/externalpackages" 2>/dev/null || true

    mkdir -p /workspace
    # Zoomy core + the FastAPI server (LAST, so a failure aborts under set -e).
    export PYTHONPATH="/opt/petsc/arch-container-opt/lib:$PYTHONPATH"
    python3 -m pip install --no-cache-dir --break-system-packages \
        /opt/src/zoomy_core /opt/src/zoomy_server /opt/src/zoomy_prepost
    rm -rf /opt/src

%runscript
    # Triple-purpose dispatch ($ZOOMY_ADAPTER=dmplex baked):
    #   run img | run img <port> | run img server [adapter] [port]
    #   run img jupyter [port] | run img shell
    case "${1:-}" in
        jupyter)    exec zoomy-jupyter --port "${2:-8888}" ;;
        shell|bash) exec /bin/bash ;;
        server)     exec zoomy-server --adapter "${2:-$ZOOMY_ADAPTER}" --port "${3:-$ZOOMY_PORT}" ;;
        "")         exec zoomy-server --adapter "$ZOOMY_ADAPTER" --port "$ZOOMY_PORT" ;;
        *)          exec zoomy-server --adapter "$ZOOMY_ADAPTER" --port "$1" ;;
    esac

%startscript
    exec zoomy-server --adapter "$ZOOMY_ADAPTER" --port "$ZOOMY_PORT"

%test
    export PETSC_DIR=/opt/petsc PETSC_ARCH=arch-container-opt
    export PYTHONPATH="/opt/petsc/arch-container-opt/lib:$PYTHONPATH"
    python3 -c "import zoomy_core, zoomy_server, zoomy_prepost, h5py, meshio; print('zoomy imports OK')"
    test -f "$PETSC_DIR/$PETSC_ARCH/lib/libpetsc.so" && echo "PETSc library OK"
    python3 -c "import petsc4py; petsc4py.init(); from petsc4py import PETSc; print('petsc4py OK')"
    zoomy-server  --help >/dev/null 2>&1 && echo "zoomy-server CLI OK"
    zoomy-jupyter --help >/dev/null 2>&1 && echo "zoomy-jupyter CLI OK"
