Bootstrap: docker
From: ghcr.io/zoomylab/zoomy_jax_dev:latest

# Triple-purpose JAX image (jax_dev conda `zoomy` env + zoomy_core/jax/server):
#   1. Solver API : apptainer run [--nv] zoomy_jax.sif [port]        (FastAPI :8080)
#   2. Jupyter    : apptainer run [--nv] zoomy_jax.sif jupyter [port]     (Lab :8888)
#   3. Dev/shell  : apptainer run [--nv] zoomy_jax.sif shell
# JAX falls back to CPU without a GPU; use --nv for the device.
#   apptainer build --fakeroot containers/zoomy_jax/zoomy_jax.sif containers/zoomy_jax/zoomy_jax.def
#
# NOTE: %files dest is /opt/src, NOT /tmp (Apptainer bind-mounts host /tmp in %post).

%labels
    Author ZoomyLab
    Description JAX + Zoomy — API :8080 + Jupyter :8888 + dev shell

%files
    library/zoomy_core    /opt/src/zoomy_core
    library/zoomy_jax     /opt/src/zoomy_jax
    library/zoomy_server  /opt/src/zoomy_server
    library/zoomy_prepost /opt/src/zoomy_prepost
    library/zoomy_plotting /opt/src/zoomy_plotting

%environment
    export PATH=/opt/conda/envs/zoomy/bin:$PATH
    export CONDA_PREFIX=/opt/conda/envs/zoomy
    export ZOOMY_ADAPTER=jax
    export ZOOMY_PORT=8080
    export ZOOMY_ROOT=/workspace
    export MPLBACKEND=Agg
    export OMPI_ALLOW_RUN_AS_ROOT=1 OMPI_ALLOW_RUN_AS_ROOT_CONFIRM=1

%post
    set -e
    export PATH=/opt/conda/envs/zoomy/bin:$PATH
    # The same steps, in the same order, as the Dockerfile: CI builds the Dockerfile and
    # converts it to the published SIF; this recipe is the local build of that image.
    /opt/conda/envs/zoomy/bin/python -m pip install --no-cache-dir \
        /opt/src/zoomy_core /opt/src/zoomy_jax /opt/src/zoomy_server /opt/src/zoomy_prepost \
        /opt/src/zoomy_plotting \
        pytest-html jupytext nbformat nbclient jupyterlab jupyter-server ipykernel
    rm -rf /opt/src
    # MPI on the CPU for distributed runs (`comm=`; the matrix's mpiN configs) and preCICE
    # (pyprecice 3.4.0, the other participants' version; petsc4py, imported before it by the
    # JAX participant), as in the Dockerfile (the stack pinned to the installed builds);
    # GPU-aware MPI, AmgX: zoomy_jax_mpi
    pins=$(/opt/conda/bin/conda list -n zoomy --export '^(python|numpy|scipy|jax|jaxlib)$' \
           | grep -v '^#')
    /opt/conda/bin/mamba install -n zoomy -y -c conda-forge $pins \
        "openmpi>=5,<6" mpi4py "mpi4jax=0.9.1.post2" "pyprecice=3.4.0" petsc4py
    /opt/conda/bin/conda clean -afy
    /opt/conda/envs/zoomy/bin/python -c "import petsc4py, precice; v = precice.get_version_information().split(b';')[0]; assert v == b'3.4.0', v; print('preCICE', v.decode())"
    mkdir -p /workspace

%runscript
    # Triple-purpose dispatch ($ZOOMY_ADAPTER=jax baked):
    #   run img | run img <port> | run img server [adapter] [port]
    #   run img jupyter [port] | run img shell
    case "${1:-}" in
        jupyter)    exec zoomy-jupyter --port "${2:-8888}" ;;
        shell|bash) exec /bin/bash ;;
        server)     exec zoomy-server --adapter "${2:-$ZOOMY_ADAPTER}" --port "${3:-$ZOOMY_PORT}" ;;
        "")         exec zoomy-server --adapter "$ZOOMY_ADAPTER" --port "$ZOOMY_PORT" ;;
        *)          exec zoomy-server --adapter "$ZOOMY_ADAPTER" --port "$1" ;;
    esac

%startscript
    exec zoomy-server --adapter "$ZOOMY_ADAPTER" --port "$ZOOMY_PORT"

%test
    /opt/conda/envs/zoomy/bin/python -c "import zoomy_core, zoomy_jax, zoomy_server, zoomy_prepost, h5py, meshio; print('imports OK')"
    zoomy-server  --help >/dev/null 2>&1 && echo "zoomy-server CLI OK"
    zoomy-jupyter --help >/dev/null 2>&1 && echo "zoomy-jupyter CLI OK"
    /opt/conda/envs/zoomy/bin/python -c "import jupyterlab" && echo "jupyterlab OK"
    /opt/conda/envs/zoomy/bin/python -c "import petsc4py, precice" && echo "pyprecice OK"
    mpiexec -n 2 /opt/conda/envs/zoomy/bin/python -c "from mpi4py import MPI; import mpi4jax, jax.numpy as jnp; c = MPI.COMM_WORLD; s = mpi4jax.allreduce(jnp.ones(1), op=MPI.SUM, comm=c); assert float(s[0]) == c.Get_size() == 2; print('mpi4jax allreduce OK, rank', c.Get_rank())"
