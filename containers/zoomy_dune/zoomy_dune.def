Bootstrap: docker
From: ubuntu:24.04

%labels
    org.opencontainers.image.description DUNE-FEM (UFL/DG) backend container for Zoomy

%environment
    export LC_ALL=C
    export OMPI_MCA_rmaps_base_oversubscribe=1
    export OMPI_ALLOW_RUN_AS_ROOT=1
    export OMPI_ALLOW_RUN_AS_ROOT_CONFIRM=1
    # dune-py JIT-compiles every algorithm into a module cache. The image is
    # read-only, so the cache MUST live in the bound workspace, not in the
    # container. Overridable; defaults next to the case being run.
    export DUNE_PY_DIR="${DUNE_PY_DIR:-$PWD/.dune-py}"
    # OpenMP is how dune.fem.threading parallelises. `dune.fem.threading.max`
    # is omp_get_max_threads(), i.e. it is CAPPED BY THIS VARIABLE -- setting
    # `dune.fem.threading.use = 8` with OMP_NUM_THREADS=1 silently gives you
    # one thread, and an empty value counts as 1 too. Default to the 4 the
    # tutorials ask for; raise it per run (`--env OMP_NUM_THREADS=16`).
    export OMP_NUM_THREADS="${OMP_NUM_THREADS:-4}"

%post
    set -e
    export DEBIAN_FRONTEND=noninteractive
    apt-get update && apt-get install -y --no-install-recommends \
        build-essential g++ gfortran cmake git ca-certificates pkg-config \
        python3 python3-dev python3-pip python3-venv \
        libopenmpi-dev openmpi-bin \
        libsuitesparse-dev libtbb-dev libmetis-dev libparmetis-dev \
        libscotch-dev libptscotch-dev zlib1g-dev wget \
    && rm -rf /var/lib/apt/lists/*

    # Python side first: dune's pip build needs numpy headers present.
    # mpi4py is NOT optional: the apt MPI above makes dune configure WITH MPI,
    # and `import dune.common` then hard-errors without the Python bindings
    # ("The Dune modules were configured using MPI ... pip install mpi4py").
    python3 -m pip install --no-cache-dir --break-system-packages \
        numpy scipy matplotlib meshio h5py gmsh mpi4py \
        jupyterlab jupyter-server ipykernel jupytext

    # The DUNE stack. One pinned minor for ALL modules: dune-py refuses to mix
    # module versions, and a 2.9 dune-fem-dg against a 2.12 dune-fem is exactly
    # the skew that makes `import dune.femdg` fail at build time.
    python3 -m pip install --no-cache-dir --break-system-packages \
        dune-common==2.12.0.2 dune-geometry==2.12.0.2 dune-grid==2.12.0.2 \
        dune-istl==2.12.0.2 dune-localfunctions==2.12.0.2 \
        dune-alugrid==2.12.0.2 dune-fem==2.12.0.2 dune-fem-dg==2.12.0.2 \
        dune-polygongrid==2.12.0.2

    mkdir -p /workspace

%runscript
    #!/bin/sh
    # run img                -> python3
    # run img jupyter [port] -> Jupyter Lab
    # run img shell          -> bash
    # run img <cmd> [args]   -> exec the command
    case "${1:-}" in
        jupyter) exec jupyter lab --no-browser --ip=0.0.0.0 --port "${2:-8888}" \
                      --ServerApp.root_dir=/workspace ;;
        shell|bash) if [ $# -le 1 ]; then exec /bin/bash; else shift; exec "$@"; fi ;;
        "")      exec python3 ;;
        *)       exec "$@" ;;
    esac

%test
    # Gate on exactly what the Euler demo imports, so a broken image cannot
    # ship. Import-only: no JIT compile, so this stays seconds, not minutes.
    # NB `dune.fem.threading` is an ATTRIBUTE of dune.fem, not a submodule --
    # `import dune.fem.threading` raises ModuleNotFoundError.
    python3 -c "
import dune.fem, dune.alugrid, dune.femdg
from dune.alugrid import aluSimplexGrid
from dune.fem.space import dgonb, finiteVolume
from dune.femdg import femDGOperator, BndValue
from dune.femdg.rk import femdgStepper
dune.fem.threading.use = 2
print('threading: use=%s max=%s' % (dune.fem.threading.use, dune.fem.threading.max))
print('dune stack import OK')
"
