Bootstrap: docker
From: ubuntu:24.04

%labels
    Author ZoomyLab
    Description DUNE-FEM (UFL / DG, unstructured AMR) + Zoomy

%files
    containers/zoomy_dune/patches /opt/patches
    library/zoomy_core     /opt/src/zoomy_core
    library/zoomy_server   /opt/src/zoomy_server
    library/zoomy_prepost  /opt/src/zoomy_prepost
    library/zoomy_plotting /opt/src/zoomy_plotting
    library/zoomy_dune     /opt/src/zoomy_dune

%environment
    export ZOOMY_ROOT=/workspace
    export ZOOMY_ADAPTER=dune
    export ZOOMY_PORT=8080
    export LC_ALL=C
    export PATH="/usr/local/bin:$PATH"
    export OMPI_MCA_rmaps_base_oversubscribe=1
    # dune-py JIT-compiles every algorithm into a module cache. The image is
    # read-only, so the cache MUST live in the bound workspace, not in the
    # container. Overridable; defaults next to the case being run.
    export DUNE_PY_DIR="${DUNE_PY_DIR:-$PWD/.dune-py}"
    # `dune.fem.threading.max` is omp_get_max_threads(), i.e. it is CAPPED BY
    # THIS VARIABLE -- `dune.fem.threading.use = 8` under OMP_NUM_THREADS=1
    # silently gives you one thread, and an empty value counts as 1 too.
    # Default to the 4 the tutorials ask for; raise it per run.
    export OMP_NUM_THREADS="${OMP_NUM_THREADS:-4}"

%post
    set -e
    export DEBIAN_FRONTEND=noninteractive
    apt-get update && apt-get install -y --no-install-recommends \
        build-essential g++ gfortran cmake git ca-certificates pkg-config \
        python3 python3-pip python3-dev python3-venv \
        libopenmpi-dev openmpi-bin libhdf5-openmpi-dev \
        libsuitesparse-dev libtbb-dev libmetis-dev libparmetis-dev \
        libscotch-dev libptscotch-dev zlib1g-dev wget \
    && rm -rf /var/lib/apt/lists/*

    # The SAME python set the other backend images ship (zoomy_amrex.def /
    # zoomy_numpy), plus mpi4py: the apt MPI above makes dune configure WITH
    # MPI, and `import dune.common` then hard-errors without the bindings.
    python3 -m pip install --no-cache-dir --break-system-packages \
        numpy scipy sympy attrs meshio pytest pytest-html rasterio h5py mpi4py \
        matplotlib jupytext nbformat nbclient \
        "fastapi>=0.100" "uvicorn[standard]>=0.20" \
        jupyterlab jupyter-server ipykernel

    # The DUNE stack. One pinned minor for ALL modules: dune-py refuses to mix
    # module versions, and a 2.9 dune-fem-dg against a 2.12 dune-fem is exactly
    # the skew that makes `import dune.femdg` fail at build time.
    python3 -m pip install --no-cache-dir --break-system-packages \
        dune-common==2.12.0.2 dune-geometry==2.12.0.2 dune-grid==2.12.0.2 \
        dune-istl==2.12.0.2 dune-localfunctions==2.12.0.2 \
        dune-alugrid==2.12.0.2 dune-fem==2.12.0.2 dune-fem-dg==2.12.0.2 \
        dune-polygongrid==2.12.0.2

    # dune-fem-dg 2.12.0.2 cannot instantiate a user-defined advection flux;
    # see patches/apply.sh. Upstream's own pydemo fails the same way.
    sh /opt/patches/apply.sh
    rm -rf /opt/patches

    mkdir -p /workspace

    # Zoomy itself, so a case needs only the mesh and the case file -- never a
    # bind of the repo.
    python3 -m pip install --no-cache-dir --break-system-packages \
        /opt/src/zoomy_core /opt/src/zoomy_server \
        /opt/src/zoomy_prepost /opt/src/zoomy_plotting /opt/src/zoomy_dune
    rm -rf /opt/src

%runscript
    # Same triple-purpose dispatch as the other backend images. A bare run
    # drops to python3; no BACKEND marker yet, so CI runs no server smoke test.
    case "${1:-}" in
        jupyter)    exec zoomy-jupyter --port "${2:-8888}" ;;
        shell|bash) if [ $# -le 1 ]; then exec /bin/bash; else shift; exec "$@"; fi ;;
        server)     exec zoomy-server --adapter "${2:-$ZOOMY_ADAPTER}" --port "${3:-$ZOOMY_PORT}" ;;
        "")         exec python3 ;;
        *)          exec "$@" ;;
    esac

%test
    # Gate on everything a case actually imports -- dune AND the zoomy chain
    # that lowers the model to UFL. Import-only: seconds, no JIT.
    python3 -c "
import dune.fem, dune.alugrid, dune.femdg, dune.polygongrid
from dune.alugrid import aluSimplexGrid
from dune.fem.space import dgonb, finiteVolume, lagrange
from dune.fem.operator import molGalerkin
from dune.fem.scheme import galerkin
from dune.femdg import femDGOperator, createLimiter
from dune.grid import reader
import zoomy_core, zoomy_prepost, zoomy_plotting, h5py, meshio, ufl
from zoomy_dune import HyperbolicSolver
from zoomy_core.transformation.to_ufl import UFLRuntimeModel
from zoomy_core.fvm.riemann_solvers import PositiveNonconservativeHLL
from zoomy_core.model.models.malpasset import MalpassetSWE
dune.fem.threading.use = 2
print('threading: use=%s max=%s' % (dune.fem.threading.use, dune.fem.threading.max))
print('dune + zoomy_core + to_ufl imports OK')
"
    zoomy-jupyter --help >/dev/null 2>&1 && echo "zoomy-jupyter CLI OK"
