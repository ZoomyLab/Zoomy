{
  "compilerOptions": {
    "module": "CommonJS", "target": "ES2019", "lib": ["ES2020", "DOM"],
    "jsx": "react", "moduleResolution": "node",
    "declaration": true, "sourceMap": false,
    "rootDir": "src", "outDir": "lib",
    "experimentalDecorators": true, "emitDecoratorMetadata": true,
    "skipLibCheck": true, "esModuleInterop": true, "strict": false
  },
  "include": ["src"]
}
